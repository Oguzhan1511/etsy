// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model EtsyToken {
  id           Int      @id @default(autoincrement())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  password          String
  role              String   @default("USER") // ADMIN or USER
  plan              String   @default("none")
  tokens            Int      @default(30)
  paymentStatus     Boolean  @default(false)
  isVerified        Boolean  @default(false)
  verificationToken String?
  printifyToken     String? // B2B Multi-tenant Printify Key
  authProvider      String   @default("email")
  googleId          String?  @unique
  subscriptionStatus String   @default("none") // "trial", "active", "cancelled", "none"
  trialEndsAt       DateTime?
  nextBillingDate   DateTime?
  cardLast4         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions Transaction[]
  tokenUsages  TokenUsage[]
  etsyToken    EtsyToken?
  supportTickets SupportTicket[]
  supportMessages SupportMessage[]
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Float
  currency    String   @default("TRY")
  planName    String
  iyzicoToken String?
  status      String   @default("SUCCESS")
  createdAt   DateTime @default(now())
}

model TokenUsage {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  amount     Int
  actionType String // e.g. "product_analysis", "mockup_generation"
  createdAt  DateTime @default(now())
}

model ErrorLog {
  id        String   @id @default(uuid())
  message   String
  stack     String?
  source    String // e.g. "etsy_api", "frontend", "iyzico"
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EtsyDailyStat {
  id               String   @id @default(uuid())
  userId           String
  date             DateTime // Midnight UTC of the target date
  views            Int      @default(0)
  favorites        Int      @default(0)
  salesCount       Int      @default(0)
  activeListings   Int      @default(0)
  revenue          Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, date])
}

model VideoJob {
  id            String   @id @default(uuid())
  status        String   @default("pending")
  script        String?
  voiceoverUrl  String?
  videoUrl      String?
  finalVideoUrl String?
  youtubeUrl    String?
  errorMessage  String?
  falRequestId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  status    String   @default("OPEN") // OPEN, IN_PROGRESS, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  SupportMessage[]
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
}
